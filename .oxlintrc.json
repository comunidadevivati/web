{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "jsPlugins": [
    "eslint-plugin-perfectionist",
    "@stylistic/eslint-plugin",
    "eslint-plugin-better-tailwindcss",
    "./.config/oxlint/project-plugin.mjs"
  ],
  "ignorePatterns": [
    "src/app/router/routeTree.gen.ts",
    "dist/**",
    "coverage/**",
    ".config/oxlint/**",
    "worker/worker-configuration.d.ts"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-default-export": "error",
    "func-style": ["error", "expression"],
    "prefer-arrow-callback": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "perfectionist/sort-imports": [
      "error",
      {
        "type": "alphabetical",
        "order": "asc",
        "newlinesBetween": 0,
        "newlinesInside": 0,
        "partitionByNewLine": false,
        "groups": [
          ["builtin", "external", "internal", "parent", "sibling", "index", "side-effect", "style"],
          "unknown"
        ],
        "sortSideEffects": true
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": "*"
      },
      {
        "blankLine": "never",
        "prev": "import",
        "next": "import"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": ["./**", "../**"]
      }
    ],
    "@stylistic/semi": ["error", "always"],
    "project/direct-export": "error",
    "@stylistic/no-multiple-empty-lines": [
      "error",
      {
        "max": 1,
        "maxBOF": 0,
        "maxEOF": 0
      }
    ],
    "@stylistic/eol-last": ["error", "always"],
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "all",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-unused-expressions": "error",
    "import/no-empty-named-blocks": "error",
    "@stylistic/indent": [
      "error",
      2,
      {
        "SwitchCase": 1
      }
    ],
    "@stylistic/jsx-indent-props": ["error", 2],
    "better-tailwindcss/enforce-consistent-line-wrapping": [
      "error",
      {
        "entryPoint": "src/index.css",
        "printWidth": 100,
        "indent": 2,
        "group": "never",
        "preferSingleLine": true,
        "selectors": [
          {
            "kind": "attribute",
            "name": "^className$"
          },
          {
            "kind": "attribute",
            "name": "^className$",
            "match": [
              {
                "type": "strings"
              }
            ]
          },
          {
            "kind": "callee",
            "name": "^cn$",
            "match": [
              {
                "type": "strings"
              },
              {
                "type": "objectKeys"
              }
            ]
          },
          {
            "kind": "callee",
            "name": "^cva$",
            "match": [
              {
                "type": "strings"
              }
            ]
          },
          {
            "kind": "callee",
            "name": "^cva$",
            "match": [
              {
                "type": "objectValues",
                "path": "^variants.*$"
              }
            ]
          },
          {
            "kind": "callee",
            "name": "^cva$",
            "match": [
              {
                "type": "objectValues",
                "path": "^compoundVariants\\[\\d+\\]\\.(?:className|class)$"
              }
            ]
          },
          {
            "kind": "variable",
            "name": "^(?:classNames?|\\w+ClassNames?)$",
            "match": [
              {
                "type": "strings"
              }
            ]
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "rules": {
        "project/no-hardcoded-colors": "error"
      }
    },
    {
      "files": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "worker/index.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["src/components/ui/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/features/**/presentation/pages/**/*.tsx",
        "src/app/router/layouts/**/*.tsx",
        "src/components/**/*.tsx"
      ],
      "rules": {
        "project/no-native-jsx-elements": "error"
      }
    },
    {
      "files": ["src/components/ui/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off",
        "project/no-native-jsx-elements": "off"
      }
    }
  ]
}
